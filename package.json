{
  "name": "metaverse-office-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "backend:start": "node src/index.js",
    "backend:test": "node --test tests/*.test.js",
    "web:dev": "pnpm --filter @metaverse-office/web dev",
    "web:build": "pnpm --filter @metaverse-office/web build",
    "web:preview": "pnpm --filter @metaverse-office/web preview",
    "web:test": "pnpm --filter @metaverse-office/web test",
    "web:test:browser-smoke": "pnpm --filter @metaverse-office/web test:browser-smoke",
    "web:test:browser-smoke:live-evidence": "pnpm --filter @metaverse-office/web test:browser-smoke:live-evidence",
    "web:test:browser-smoke:dev": "pnpm --filter @metaverse-office/web test:browser-smoke:dev",
    "verify:quick": "node scripts/verify-quick.mjs",
    "test": "pnpm test:all",
    "test:all": "pnpm backend:test && pnpm web:test && pnpm web:typecheck && pnpm web:build && pnpm web:test:browser-smoke && pnpm web:test:browser-smoke:dev",
    "web:typecheck": "pnpm --filter @metaverse-office/web typecheck"
  }
}
